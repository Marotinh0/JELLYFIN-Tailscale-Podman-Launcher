[Desktop Entry]
# Desktop launcher for the AMD edition.
# 1. Change /home/YOUR_USER/bin/... to the real, ABSOLUTE path of the script
#    (the Desktop Entry spec does not expand "~" or $HOME in Exec).
# 2. Save it as ~/.local/share/applications/jellyfin-amd.desktop
#    (and/or copy it to your Desktop). Then run: update-desktop-database ~/.local/share/applications
# Clicking the icon starts Jellyfin; clicking it again stops it.
Type=Application
Name=Jellyfin (AMD)
Comment=Start / stop the Jellyfin server (rootless Podman)
Exec=/home/YOUR_USER/bin/jellyfin-amd.sh
Icon=jellyfin
Terminal=false
Categories=AudioVideo;Video;Network;
StartupNotify=false
Actions=Status;Update;

[Desktop Action Status]
Name=Show status
Exec=/home/YOUR_USER/bin/jellyfin-amd.sh status

[Desktop Action Update]
Name=Update Jellyfin now
Exec=/home/YOUR_USER/bin/jellyfin-amd.sh update



------------------------------------------------------------------------------------------------------------------------------------------

